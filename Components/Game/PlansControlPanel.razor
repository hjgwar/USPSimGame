@namespace USPSimGame.Components.Game
@using USPSimGame.Data.Entities

<div class="plans-control-panel-container z-3">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden plans-control-card">
        <!-- Panel Header -->
        <div class="card-header bg-transparent border-bottom p-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-success-subtle text-success">
                    <i class="bi bi-diagram-3-fill h5 mb-0"></i>
                </span>
                <div>
                    <h6 class="fw-bold text-dark mb-0">Spatial Plans</h6>
                    <small class="text-muted">@Plans.Count Plan(s) Registered</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-success rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" @onclick="TriggerOpenNewPlanAsync" title="Create New Spatial Plan">
                    <i class="bi bi-plus-lg"></i>
                </button>
                <button class="btn btn-sm btn-light rounded-circle shadow-sm" @onclick="ToggleCollapse" title="@(IsCollapsed ? "Expand panel" : "Collapse panel")">
                    <i class="bi @(IsCollapsed ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            </div>
        </div>

        @if (!IsCollapsed)
        {
            <div class="card-body p-3 panel-content-body overflow-auto" style="max-height: 280px;">
                @if (IsLoading)
                {
                    <div class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                        <span class="ms-2 text-muted small">Loading spatial plans...</span>
                    </div>
                }
                else if (!Plans.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-folder-x display-6 d-block mb-2"></i>
                        <p class="small mb-2">No spatial plans registered yet.</p>
                        <button class="btn btn-sm btn-outline-success rounded-pill px-3" @onclick="TriggerOpenNewPlanAsync">
                            <i class="bi bi-plus-lg me-1"></i>Create First Plan
                        </button>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var plan in Plans)
                        {
                            bool isSelected = ActivePlan?.Id == plan.Id;

                            <div class="card border rounded-3 p-2 plan-item-card cursor-pointer transition-all @(isSelected ? "border-success bg-success-subtle shadow-sm" : "bg-white hover-bg-light")" @onclick="() => SelectPlanAsync(plan)">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="badge border font-monospace small px-2 py-1 @GetStateBadgeClass(plan.State)">
                                        @plan.State
                                    </span>
                                    <small class="text-muted fw-semibold micro-text">
                                        <i class="bi bi-calendar-event me-1"></i>@FormatMonthYear(plan.StartMonth)
                                    </small>
                                </div>

                                <h6 class="fw-bold text-dark mb-1 small">@plan.Name</h6>

                                <div class="d-flex justify-content-between align-items-center micro-text text-muted">
                                    <span><i class="bi bi-people me-1"></i>@(plan.Team?.Name ?? "Team")</span>
                                    <span><i class="bi bi-layers me-1"></i>@plan.Features.Count Feature(s)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

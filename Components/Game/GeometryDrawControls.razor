@namespace USPSimGame.Components.Game

<div class="geometry-draw-controls-container">
    @if (IsActive)
    {
        <div class="p-2 rounded-3 bg-light border d-flex align-items-center justify-content-between mb-2">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center text-white" style="background-color: @Color; width: 32px; height: 32px;">
                    <i class="bi @Icon small mb-0"></i>
                </div>
                <div>
                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle micro-text me-1">
                        @GeometryType
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle micro-text">
                        @Category
                    </span>
                </div>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle micro-text animate-pulse">
                <i class="bi bi-pencil me-1"></i>Drawing Active
            </span>
        </div>

        <!-- Undo / Redo / Delete Controls -->
        <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-white border">
            <small class="fw-semibold text-muted micro-text">
                <i class="bi bi-vector-pen me-1 text-primary"></i>Controls:
            </small>
            <div class="d-flex gap-1">
                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill undo-redo-btn" @onclick="UndoAsync" title="Undo point">
                    <i class="bi bi-arrow-counterclockwise me-1 text-primary"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill undo-redo-btn" @onclick="RedoAsync" title="Redo point">
                    <i class="bi bi-arrow-clockwise me-1 text-primary"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill undo-redo-btn" @onclick="DeletePointAsync" title="Click a point on map to select, then click here to delete">
                    <i class="bi bi-trash me-1"></i>
                </button>
            </div>
        </div>
    }
</div>

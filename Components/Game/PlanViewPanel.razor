@namespace USPSimGame.Components.Game
@using USPSimGame.Data.Entities

<div class="plan-view-panel-container position-fixed bottom-0 end-0 m-3 z-3">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden plan-view-card" style="width: 360px; max-width: calc(100vw - 32px);">
        <!-- Header -->
        <div class="card-header bg-transparent border-bottom p-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-primary-subtle text-primary">
                    <i class="bi bi-eye-fill h5 mb-0"></i>
                </span>
                <div>
                    <h6 class="fw-bold text-dark mb-0">Active Spatial Plan</h6>
                    <small class="text-muted">Viewing Plan #@Plan.Id</small>
                </div>
            </div>
            <button class="btn-close" @onclick="CloseAsync" title="Close plan view"></button>
        </div>

        <div class="card-body p-3 overflow-auto" style="max-height: 380px;">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge border font-monospace px-3 py-1 @GetStateBadgeClass(Plan.State)">
                    @Plan.State
                </span>
                <span class="badge bg-light text-dark border font-monospace small">
                    <i class="bi bi-calendar-check text-primary me-1"></i>@FormatMonthYear(Plan.StartMonth)
                </span>
            </div>

            <h5 class="fw-bold text-dark mb-1">@Plan.Name</h5>

            <p class="text-muted small mb-3">
                @(string.IsNullOrWhiteSpace(Plan.Description) ? "No plan description provided." : Plan.Description)
            </p>

            <div class="bg-light p-3 rounded-3 border mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                    <small class="text-uppercase fw-bold text-muted micro-text">Proposing Team</small>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                        <i class="bi bi-people-fill me-1"></i>@(Plan.Team?.Name ?? "Team")
                    </span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-uppercase fw-bold text-muted micro-text">Created On</small>
                    <span class="text-dark small font-monospace">@Plan.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
            </div>

            <h6 class="fw-bold text-dark small mb-2">
                <i class="bi bi-diagram-2 me-1 text-success"></i>Plan Features & Geometries (@Plan.Features.Count)
            </h6>

            <div class="d-flex flex-column gap-2">
                @foreach (var feat in Plan.Features)
                {
                    var pDef = feat.GameSessionPlannableLayer?.PlannableLayerDefinition;

                    <div class="p-2 rounded-3 bg-white border d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle p-2 d-flex align-items-center justify-content-center text-white" style="background-color: @(pDef?.DefaultColor ?? "#10b981"); width: 32px; height: 32px;">
                                <i class="bi @(pDef?.Icon ?? "bi-layers-fill") small mb-0"></i>
                            </div>
                            <div>
                                <span class="badge bg-secondary-subtle text-secondary micro-text me-1">@(pDef?.Category)</span>
                                <span class="badge bg-warning-subtle text-dark micro-text">@(pDef?.GeometryType)</span>
                                <div class="fw-semibold text-dark small">@(pDef?.Name ?? "Plannable Layer")</div>
                            </div>
                        </div>

                        <span class="badge bg-success-subtle text-success border border-success-subtle micro-text">
                            <i class="bi bi-geo-alt-fill me-1"></i>Drawn Map Feature
                        </span>
                    </div>
                }
            </div>
        </div>

        <div class="card-footer bg-transparent border-top p-3 d-flex justify-content-end">
            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4" @onclick="CloseAsync">
                Close Plan View
            </button>
        </div>
    </div>
</div>

@page "/creator/layers"
@using USPSimGame.Components.Creator
@using USPSimGame.Data.Entities
@inject NavigationManager Navigation
@inject USPSimGame.Services.CreatorAuthState AuthState
@inject USPSimGame.Services.Layers.IMapLayerService MapLayerService
@rendermode InteractiveServer

<PageTitle>Map & Plannable Layers - Creator Portal</PageTitle>

<div class="creator-page bg-light min-vh-100 pb-5">
    <CreatorHeader />

    <div class="container">
        @if (!AuthState.IsAuthenticated)
        {
            <div class="card shadow-sm p-4 text-center border-0 rounded-4">
                <i class="bi bi-shield-lock display-4 text-secondary mb-3"></i>
                <h4 class="fw-bold">Access Restricted</h4>
                <p class="text-muted mb-3">Please log in to access the Creator Portal.</p>
                <div>
                    <a href="creator" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Go to Login
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                <div>
                    <h2 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-layers-fill text-primary me-2"></i>Global Catalog Management
                    </h2>
                    <p class="text-muted mb-0">
                        Manage baseline OpenData layers and plannable development layers for Game Sessions.
                    </p>
                </div>
                @if (ActiveTab == "plannable")
                {
                    <div>
                        <button class="btn btn-success rounded-pill px-4" @onclick="OpenCreatePlannableModal">
                            <i class="bi bi-plus-lg me-1"></i>New Plannable Layer
                        </button>
                    </div>
                }
            </div>

            <!-- Tab Navigation -->
            <ul class="nav nav-pills mb-4 gap-2 bg-white p-2 rounded-4 shadow-sm border">
                <li class="nav-item">
                    <button class="nav-link rounded-pill px-4 @(ActiveTab == "baseline" ? "active" : "")" @onclick='() => SetTab("baseline")'>
                        <i class="bi bi-hdd-stack me-2"></i>Baseline Map Layers (@LayerDefinitions.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link rounded-pill px-4 @(ActiveTab == "plannable" ? "active" : "")" @onclick='() => SetTab("plannable")'>
                        <i class="bi bi-pencil-square me-2"></i>Plannable Development Layers (@PlannableDefinitions.Count)
                    </button>
                </li>
            </ul>

            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading catalog...</span>
                    </div>
                    <p class="text-muted mt-2">Loading Layer Catalog...</p>
                </div>
            }
            else if (ActiveTab == "baseline")
            {
                <!-- Baseline Map Layers Tab -->
                <div class="row g-4">
                    @foreach (var layer in LayerDefinitions)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100 layer-card">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="badge bg-secondary-subtle text-secondary fw-semibold mb-2 me-1">
                                                <i class="bi bi-tag-fill me-1"></i>@layer.Category
                                            </span>
                                            <span class="badge bg-info-subtle text-info fw-semibold mb-2">
                                                <i class="bi bi-file-earmark-code me-1"></i>@layer.LayerType
                                            </span>
                                            <h4 class="card-title fw-bold text-dark mb-1">@layer.Name</h4>
                                            <code class="text-muted small">@layer.Key</code>
                                        </div>
                                        @if (layer.IsEnabledByDefault)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i>Default Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill">
                                                Optional
                                            </span>
                                        }
                                    </div>

                                    <p class="card-text text-muted mb-4 flex-grow-1">
                                        @layer.Description
                                    </p>

                                    <div class="tags-section bg-light p-3 rounded-3 mb-3 border">
                                        <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                                            <span class="fw-bold text-dark small text-uppercase tags-section-header">
                                                <i class="bi bi-globe me-1 text-primary"></i>Catalog Default Tags
                                            </span>
                                            <button class="btn btn-sm btn-outline-primary py-0 px-2 edit-btn-small" @onclick="() => OpenEditBaselineModal(layer)">
                                                <i class="bi bi-pencil me-1"></i>Edit Catalog Defaults
                                            </button>
                                        </div>

                                        <div class="mb-2">
                                            <small class="text-uppercase text-muted fw-bold d-block mb-1 tag-label-micro">
                                                <i class="bi bi-translate me-1 text-primary"></i>Translator Tags
                                            </small>
                                            @if (!string.IsNullOrWhiteSpace(layer.TranslatorTags))
                                            {
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var tag in layer.TranslatorTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace tag-badge">
                                                            @tag
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic tag-empty-text">No default translator tags set</span>
                                            }
                                        </div>

                                        <div>
                                            <small class="text-uppercase text-muted fw-bold d-block mb-1 tag-label-micro">
                                                <i class="bi bi-cpu me-1 text-success"></i>Simulator Tags
                                            </small>
                                            @if (!string.IsNullOrWhiteSpace(layer.SimulatorTags))
                                            {
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var tag in layer.SimulatorTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace tag-badge">
                                                            @tag
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic tag-empty-text">No default simulator tags set</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Plannable Layers Tab -->
                <div class="row g-4">
                    @foreach (var pDef in PlannableDefinitions)
                    {
                        bool isSeeded = pDef.Id <= 6;

                        <div class="col-12 col-lg-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100 layer-card">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle p-3 d-flex align-items-center justify-content-center text-white" style="background-color: @(string.IsNullOrEmpty(pDef.DefaultColor) ? "#3b82f6" : pDef.DefaultColor); width: 48px; height: 48px;">
                                                <i class="bi @(string.IsNullOrEmpty(pDef.Icon) ? "bi-layers-fill" : pDef.Icon) h5 mb-0"></i>
                                            </div>
                                            <div>
                                                <span class="badge bg-secondary-subtle text-secondary fw-semibold mb-1 me-1">
                                                    <i class="bi bi-tag-fill me-1"></i>@pDef.Category
                                                </span>
                                                <span class="badge bg-warning-subtle text-dark fw-semibold mb-1">
                                                    <i class="bi bi-vector-pen me-1"></i>@pDef.GeometryType
                                                </span>
                                                <h4 class="card-title fw-bold text-dark mb-0">@pDef.Name</h4>
                                                <code class="text-muted small">@pDef.Key</code>
                                            </div>
                                        </div>

                                        <div class="d-flex flex-column align-items-end gap-1">
                                            @if (pDef.IsEnabledByDefault)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Default Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1 rounded-pill">
                                                    Optional
                                                </span>
                                            }
                                            @if (isSeeded)
                                            {
                                                <span class="badge bg-light text-muted border px-2 py-1 small">
                                                    <i class="bi bi-lock-fill me-1"></i>Built-in Seed
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <p class="card-text text-muted mb-3 flex-grow-1">
                                        @pDef.Description
                                    </p>

                                    <div class="tags-section bg-light p-3 rounded-3 mb-3 border">
                                        <div class="mb-2">
                                            <small class="text-uppercase text-muted fw-bold d-block mb-1 tag-label-micro">
                                                <i class="bi bi-translate me-1 text-primary"></i>Translator Tags
                                            </small>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">
                                                @(string.IsNullOrEmpty(pDef.TranslatorTags) ? "none" : pDef.TranslatorTags)
                                            </span>
                                        </div>
                                        <div>
                                            <small class="text-uppercase text-muted fw-bold d-block mb-1 tag-label-micro">
                                                <i class="bi bi-cpu me-1 text-success"></i>Simulator Tags
                                            </small>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace">
                                                @(string.IsNullOrEmpty(pDef.SimulatorTags) ? "none" : pDef.SimulatorTags)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end align-items-center gap-2 pt-2 border-top">
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => OpenEditPlannableModal(pDef)">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>
                                        @if (!isSeeded)
                                        {
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => DeletePlannableLayerAsync(pDef.Id)">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Edit Baseline Tags Modal -->
@if (ShowEditBaselineModal && EditingBaselineLayer != null)
{
    <div class="modal fade show d-block modal-backdrop-custom" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom pb-3">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-sliders text-primary me-2"></i>Edit Catalog Default Tags
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEditBaselineModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info border-0 rounded-3 mb-4 d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill text-info h5 mb-0"></i>
                        <div class="small">
                            Editing global default tags for <strong>@EditingBaselineLayer.Name</strong>.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small text-uppercase">
                            <i class="bi bi-translate text-primary me-1"></i>Default Translator Tags
                        </label>
                        <input type="text" class="form-control font-monospace" @bind="EditTranslatorTags" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small text-uppercase">
                            <i class="bi bi-cpu text-success me-1"></i>Default Simulator Tags
                        </label>
                        <input type="text" class="form-control font-monospace" @bind="EditSimulatorTags" />
                    </div>
                </div>
                <div class="modal-footer border-top pt-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseEditBaselineModal">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="SaveBaselineTagsAsync">
                        <i class="bi bi-check-lg me-1"></i>Save Defaults
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Create / Edit Plannable Layer Modal -->
@if (ShowPlannableModal)
{
    <div class="modal fade show d-block modal-backdrop-custom" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom pb-3">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-pencil-square text-primary me-2"></i>@(IsEditingPlannable ? "Edit Plannable Layer Definition" : "Create New Plannable Layer")
                    </h5>
                    <button type="button" class="btn-close" @onclick="ClosePlannableModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Layer Key Identifier</label>
                            <input type="text" class="form-control font-monospace" @bind="EditingPlannableLayer.Key" placeholder="e.g. solar-farm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Display Name</label>
                            <input type="text" class="form-control" @bind="EditingPlannableLayer.Name" placeholder="e.g. Solar Farm Area" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark small">Description</label>
                            <textarea class="form-control" rows="2" @bind="EditingPlannableLayer.Description" placeholder="Description of what players can draw/plan with this layer..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Category</label>
                            <select class="form-select" @bind="EditingPlannableLayer.Category">
                                @foreach (var cat in Enum.GetValues<MapLayerCategory>())
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Geometry Type</label>
                            <select class="form-select" @bind="EditingPlannableLayer.GeometryType">
                                @foreach (var gtype in Enum.GetValues<PlannableGeometryType>())
                                {
                                    <option value="@gtype">@gtype</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark small">Bootstrap Icon Class</label>
                            <input type="text" class="form-control font-monospace" @bind="EditingPlannableLayer.Icon" placeholder="bi-sun-fill" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark small">Default Color (Hex)</label>
                            <input type="color" class="form-control form-control-color w-100" @bind="EditingPlannableLayer.DefaultColor" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark small">Line Width (px)</label>
                            <input type="number" step="0.5" class="form-control" @bind="EditingPlannableLayer.DefaultLineWidthPx" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Translator Tags</label>
                            <input type="text" class="form-control font-monospace" @bind="EditingPlannableLayer.TranslatorTags" placeholder="e.g. solar_pv, area" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Simulator Tags</label>
                            <input type="text" class="form-control font-monospace" @bind="EditingPlannableLayer.SimulatorTags" placeholder="e.g. pv_generation, grid_supply" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="enabledByDefault" @bind="EditingPlannableLayer.IsEnabledByDefault" />
                                <label class="form-check-label fw-semibold text-dark" for="enabledByDefault">Enable by Default in New Game Sessions</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top pt-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="ClosePlannableModal">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="SavePlannableLayerAsync">
                        <i class="bi bi-check-lg me-1"></i>Save Plannable Layer
                    </button>
                </div>
            </div>
        </div>
    </div>
}

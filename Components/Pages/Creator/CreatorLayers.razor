@page "/creator/layers"
@using USPSimGame.Components.Creator
@using USPSimGame.Data.Entities
@inject NavigationManager Navigation
@inject USPSimGame.Services.CreatorAuthState AuthState
@inject USPSimGame.Services.Layers.IMapLayerService MapLayerService
@rendermode InteractiveServer

<PageTitle>Map Layers - Creator Portal</PageTitle>

<div class="creator-page bg-light min-vh-100 pb-5">
    <CreatorHeader />

    <div class="container">
        @if (!AuthState.IsAuthenticated)
        {
            <div class="card shadow-sm p-4 text-center border-0 rounded-4">
                <i class="bi bi-shield-lock display-4 text-secondary mb-3"></i>
                <h4 class="fw-bold">Access Restricted</h4>
                <p class="text-muted mb-3">Please log in to access the Creator Portal.</p>
                <div>
                    <a href="creator" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Go to Login
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                <div>
                    <h2 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-layers-fill text-primary me-2"></i>Global Map Layer Catalog
                    </h2>
                    <p class="text-muted mb-0">
                        Manage baseline default <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">TranslatorTags</span> and <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace">SimulatorTags</span> for reusable map layers.
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                        <i class="bi bi-database-check me-1"></i>@LayerDefinitions.Count Layer(s) Registered
                    </span>
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading layers...</span>
                    </div>
                    <p class="text-muted mt-2">Loading Map Layer Catalog...</p>
                </div>
            }
            else if (!LayerDefinitions.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                    <i class="bi bi-layers text-muted display-3 mb-3"></i>
                    <h5 class="fw-bold text-dark">No Map Layers Found</h5>
                    <p class="text-muted">No map layer definitions are registered in the database catalog.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var layer in LayerDefinitions)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100 layer-card">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="badge bg-secondary-subtle text-secondary fw-semibold mb-2 me-1">
                                                <i class="bi bi-tag-fill me-1"></i>@layer.Category
                                            </span>
                                            <span class="badge bg-info-subtle text-info fw-semibold mb-2">
                                                <i class="bi bi-file-earmark-code me-1"></i>@layer.LayerType
                                            </span>
                                            <h4 class="card-title fw-bold text-dark mb-1">@layer.Name</h4>
                                            <code class="text-muted small">@layer.Key</code>
                                        </div>
                                        @if (layer.IsEnabledByDefault)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i>Default Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill">
                                                Optional
                                            </span>
                                        }
                                    </div>

                                    <p class="card-text text-muted mb-4 flex-grow-1">
                                        @layer.Description
                                    </p>

                                    <div class="tags-section bg-light p-3 rounded-3 mb-3 border">
                                        <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                                            <span class="fw-bold text-dark small text-uppercase tags-section-header">
                                                <i class="bi bi-globe me-1 text-primary"></i>Catalog Default Tags
                                            </span>
                                            <button class="btn btn-sm btn-outline-primary py-0 px-2 edit-btn-small" @onclick="() => OpenEditModal(layer)">
                                                <i class="bi bi-pencil me-1"></i>Edit Catalog Defaults
                                            </button>
                                        </div>

                                        <div class="mb-2">
                                            <small class="text-uppercase text-muted fw-bold d-block mb-1 tag-label-micro">
                                                <i class="bi bi-translate me-1 text-primary"></i>Translator Tags
                                            </small>
                                            @if (!string.IsNullOrWhiteSpace(layer.TranslatorTags))
                                            {
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var tag in layer.TranslatorTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace tag-badge">
                                                            @tag
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic tag-empty-text">No default translator tags set</span>
                                            }
                                        </div>

                                        <div>
                                            <small class="text-uppercase text-muted fw-bold d-block mb-1 tag-label-micro">
                                                <i class="bi bi-cpu me-1 text-success"></i>Simulator Tags
                                            </small>
                                            @if (!string.IsNullOrWhiteSpace(layer.SimulatorTags))
                                            {
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var tag in layer.SimulatorTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace tag-badge">
                                                            @tag
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic tag-empty-text">No default simulator tags set</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top">
                                        <span>
                                            <i class="bi bi-cloud-download me-1"></i>Pre-cached on GameSession creation
                                        </span>
                                        <span class="fw-semibold text-primary">
                                            Ready for Game Engine <i class="bi bi-arrow-right"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@if (ShowEditModal && EditingLayer != null)
{
    <div class="modal fade show d-block modal-backdrop-custom" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom pb-3">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-sliders text-primary me-2"></i>Edit Catalog Default Tags
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info border-0 rounded-3 mb-4 d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill text-info h5 mb-0"></i>
                        <div class="small">
                            Editing global default tags for <strong>@EditingLayer.Name</strong>. These tags serve as the initial template baseline whenever a new <strong>GameSession</strong> is created with this layer.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small text-uppercase">
                            <i class="bi bi-translate text-primary me-1"></i>Default Translator Tags (Comma-Separated)
                        </label>
                        <input type="text" class="form-control font-monospace" placeholder="e.g. building_extrusion, height_map, bag_pand" @bind="EditTranslatorTags" />
                        <div class="form-text">Comma-separated tags for geometry translation pipelines.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small text-uppercase">
                            <i class="bi bi-cpu text-success me-1"></i>Default Simulator Tags (Comma-Separated)
                        </label>
                        <input type="text" class="form-control font-monospace" placeholder="e.g. obstacle_mesh, line_of_sight_occluder, thermal_mass" @bind="EditSimulatorTags" />
                        <div class="form-text">Comma-separated tags for external simulator inputs.</div>
                    </div>
                </div>
                <div class="modal-footer border-top pt-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseEditModal">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="SaveCatalogDefaultTagsAsync">
                        <i class="bi bi-check-lg me-1"></i>Save Catalog Defaults
                    </button>
                </div>
            </div>
        </div>
    </div>
}

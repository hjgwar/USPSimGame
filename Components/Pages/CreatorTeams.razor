@page "/creator/teams"
@rendermode InteractiveServer

<PageTitle>Teams Management - Creator Dashboard</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    <div class="container py-4">
        <LoginCard OnLoginSuccess="HandleLoginSuccess" />
    </div>
}
else
{
    <CreatorHeader />
    <div class="container pb-5">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h2 class="mb-1 text-dark"><i class="bi bi-people-fill me-2"></i>Teams Management</h2>
                <p class="text-muted mb-0">Define and manage teams specific to your Game Sessions.</p>
            </div>
        </div>

        <TeamsOverview />
    </div>
}

@namespace USPSimGame.Components.Creator

<div class="teams-overview-container">
    <div class="card shadow-sm border-0 mb-4 session-selector-card">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2 flex-grow-1 max-w-500">
                <label class="form-label mb-0 fw-bold text-nowrap">
                    <i class="bi bi-controller me-1 text-primary"></i>Game Session:
                </label>
                @if (GameSessions != null && GameSessions.Any())
                {
                    <select class="form-select fw-semibold" value="@SelectedSessionId" @onchange="OnSessionChanged">
                        @foreach (var session in GameSessions)
                        {
                            <option value="@session.Id">@session.Name (ID: @session.Id - @session.State)</option>
                        }
                    </select>
                }
                else
                {
                    <span class="text-muted">No game sessions available</span>
                }
            </div>

            <div>
                @if (SelectedSessionId > 0 && !ShowForm)
                {
                    <button class="btn btn-primary" @onclick="StartAddTeam">
                        <i class="bi bi-plus-lg me-1"></i>Add Team
                    </button>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (GameSessions == null || !GameSessions.Any())
    {
        <div class="card shadow-sm text-center py-5 px-4 empty-state-card">
            <div class="card-body">
                <i class="bi bi-controller display-4 text-muted mb-3 d-block"></i>
                <h4 class="card-title text-secondary">No Game Sessions Available</h4>
                <p class="card-text text-muted">You must create at least one Game Session before managing teams.</p>
                <a href="creator" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i>Go to Game Sessions Page
                </a>
            </div>
        </div>
    }
    else if (ShowForm)
    {
        <TeamForm GameSessionId="SelectedSessionId" TeamToEdit="EditingTeam" OnSaved="HandleTeamSaved" OnCancel="CancelForm" />
    }

    @if (GameSessions != null && GameSessions.Any())
    {
        @if (IsLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading teams...</span>
                </div>
                <p class="text-muted mt-2">Loading teams...</p>
            </div>
        }
        else if (Teams == null || !Teams.Any())
        {
            @if (!ShowForm)
            {
                <div class="card shadow-sm text-center py-5 px-4 empty-state-card">
                    <div class="card-body">
                        <i class="bi bi-people display-4 text-muted mb-3 d-block"></i>
                        <h4 class="card-title text-secondary">No Teams Defined</h4>
                        <p class="card-text text-muted">There are no teams created yet for this Game Session.</p>
                        <button class="btn btn-primary mt-2" @onclick="StartAddTeam">
                            <i class="bi bi-plus-lg me-1"></i>Create First Team
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Color</th>
                                <th>Team Name</th>
                                <th>Password Protection</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var team in Teams)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@team.Id</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="team-color-swatch shadow-sm" style="background-color: @team.Color;"></span>
                                            <code class="text-dark font-monospace">@team.Color</code>
                                        </div>
                                    </td>
                                    <td><strong class="text-dark fs-6">@team.Name</strong></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(team.PasswordHash))
                                        {
                                            <span class="badge bg-success"><i class="bi bi-lock-fill me-1"></i>Password Set</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-unlock me-1"></i>No Password</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" @onclick="() => StartEditTeam(team)" title="Edit Team">
                                                <i class="bi bi-pencil me-1"></i>Edit
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => DeleteTeam(team.Id)" title="Delete Team">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

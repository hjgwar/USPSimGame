@namespace USPSimGame.Components.Creator

<header class="creator-header mb-4 shadow-sm">
    <div class="container d-flex flex-wrap justify-content-between align-items-center py-2">
        <div class="d-flex align-items-center gap-3">
            <span class="brand-title h5 mb-0 text-primary fw-bold">
                <i class="bi bi-gear-wide-connected me-2"></i>Creator Portal
            </span>
            <nav class="nav nav-pills nav-creator">
                <NavLink class="nav-link" href="creator" Match="NavLinkMatch.All">
                    <i class="bi bi-controller me-1"></i>Game Sessions
                </NavLink>
                <NavLink class="nav-link" href="creator/teams">
                    <i class="bi bi-people-fill me-1"></i>Teams
                </NavLink>
            </nav>
        </div>

        <div class="d-flex align-items-center gap-3 mt-2 mt-sm-0">
            @if (AuthState.CurrentUser != null)
            {
                <span class="user-badge badge bg-light text-dark border">
                    <i class="bi bi-person-circle me-1 text-primary"></i>@AuthState.CurrentUser.Username
                </span>
                <button class="btn btn-sm btn-outline-danger" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-right me-1"></i>Log Out
                </button>
            }
        </div>
    </div>
</header>

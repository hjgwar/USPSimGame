@namespace USPSimGame.Components.Creator
@using USPSimGame.Data.Entities

<div class="modal fade show d-block modal-backdrop-custom" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-people-fill text-primary me-2"></i>Session Teams Management
                    </h5>
                    <small class="text-muted">Session #@Session.Id - <strong>@Session.Name</strong></small>
                </div>
                <button type="button" class="btn-close" @onclick="CloseAsync"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Add Team Form -->
                <div class="card border-0 bg-light p-3 rounded-3 mb-4 border">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-person-plus-fill me-1 text-primary"></i>Add New Team to Session
                    </h6>
                    <div class="row g-2">
                        <div class="col-12 col-md-5">
                            <label class="form-label small fw-bold mb-1">Team Name</label>
                            <input type="text" class="form-control form-control-sm" placeholder="e.g. Energy Grid Team" @bind="NewTeamName" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold mb-1">Password / PIN</label>
                            <input type="password" class="form-control form-control-sm" placeholder="e.g. secret123" @bind="NewTeamPassword" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-bold mb-1">Color</label>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="color" class="form-control form-control-color form-control-sm" @bind="NewTeamColor" />
                                <input type="text" class="form-control form-control-sm font-monospace" @bind="NewTeamColor" />
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 text-end">
                        <button class="btn btn-sm btn-primary rounded-pill px-3" disabled="@(string.IsNullOrWhiteSpace(NewTeamName) || string.IsNullOrWhiteSpace(NewTeamPassword))" @onclick="AddTeamToSessionAsync">
                            <i class="bi bi-plus-lg me-1"></i>Add Team
                        </button>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-shield-lock me-1"></i>Configured Session Teams (@SessionTeams.Count)
                </h6>

                @if (IsLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="ms-2 text-muted">Loading teams...</span>
                    </div>
                }
                else if (!SessionTeams.Any())
                {
                    <div class="alert alert-secondary border-0 rounded-3 text-center py-3">
                        <i class="bi bi-people me-2 text-muted"></i>No teams added to this session yet. Create teams above for player access.
                    </div>
                }
                else
                {
                    <div class="table-responsive border rounded-3 bg-white">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Team Name</th>
                                    <th>Color</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var team in SessionTeams)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="rounded-circle d-inline-block team-color-dot" style="background-color: @team.Color;"></span>
                                                <strong class="text-dark">@team.Name</strong>
                                            </div>
                                        </td>
                                        <td><code class="small text-muted">@team.Color</code></td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger py-0 px-2 action-btn-small" @onclick="() => DeleteTeamFromSessionAsync(team.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="modal-footer border-top pt-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="CloseAsync">Close</button>
            </div>
        </div>
    </div>
</div>

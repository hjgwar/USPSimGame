@namespace USPSimGame.Components.Home

<div class="team-connect-container mt-4">
    <div class="card shadow-lg connect-card mx-auto">
        <div class="card-header text-center bg-primary text-white py-3">
            <h4 class="mb-0"><i class="bi bi-diagram-3-fill me-2"></i>Connect to Game: @SelectedSession.Name</h4>
        </div>
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@ErrorMessage
                    <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
                </div>
            }

            @if (IsLoadingTeams)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading teams...</span>
                    </div>
                    <p class="text-muted mt-2 mb-0">Loading available teams...</p>
                </div>
            }
            else if (Teams == null || !Teams.Any())
            {
                <div class="alert alert-warning text-center my-3" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>No teams have been defined for this Game Session yet.
                </div>
            }
            else
            {
                <EditForm Model="this" OnValidSubmit="HandleConnect">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Select Team</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-people-fill"></i></span>
                            <select class="form-select fw-semibold" @bind="SelectedTeamId" required>
                                <option value="0" disabled>-- Choose a Team --</option>
                                @foreach (var team in Teams)
                                {
                                    <option value="@team.Id">@team.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (SelectedTeam != null)
                    {
                        <div class="mb-3 d-flex align-items-center gap-2 p-2 rounded border bg-light">
                            <span class="team-color-indicator shadow-sm" style="background-color: @SelectedTeam.Color;"></span>
                            <span class="small text-secondary">Team Color: <strong>@SelectedTeam.Color</strong></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Player Name</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control" placeholder="Enter your player name" @bind="PlayerName" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label font-weight-bold">Team Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                            <input type="password" class="form-control" placeholder="Enter team password" @bind="TeamPassword" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 font-weight-bold btn-connect" disabled="@(IsConnecting || SelectedTeamId <= 0)">
                        @if (IsConnecting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Connecting...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-plug-fill me-2"></i>Connect & Start Game</span>
                        }
                    </button>
                </EditForm>
            }
        </div>
    </div>
</div>